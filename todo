SELECT
    AVG(CAST(session_duration AS BIGINT)) AS average_during_purchase
FROM(
    SELECT
        user_session,
        DATEDIFF(second, MIN(event_time), MAX(event_time)) AS session_duration,
        SUM(CASE WHEN event_type = 'purchase' THEN 1 ELSE 0 END) AS purchases
    FROM dbo.Nov_2019
    GROUP BY user_session
    HAVING DATEDIFF(second, MIN(event_time), MAX(event_time)) > 0 
)t
WHERE purchases > 0;

SELECT
    AVG(CAST(session_duration AS BIGINT)) AS average_session_length
FROM(
    SELECT
        user_session,
        DATEDIFF(second, MIN(event_time), MAX(event_time)) AS session_duration,
        SUM(CASE WHEN event_type = 'purchase' THEN 1 ELSE 0 END) AS purchases
    FROM dbo.Nov_2019
    GROUP BY user_session
    HAVING DATEDIFF(second, MIN(event_time), MAX(event_time)) > 0 
)t


