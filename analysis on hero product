WITH hero_product AS (
    SELECT 
        category_id,
        product_id,
        category_code,
        brand,
        SUM(CASE WHEN event_type = 'purchase' THEN 1 ELSE 0 END) AS purchase_counts
    FROM dbo.Nov_2019
    GROUP BY category_id, product_id, category_code, brand
), select_top AS (
SELECT TOP 1
    *
FROM hero_product
ORDER BY purchase_counts DESC
)


SELECT 
*
FROM dbo.Nov_2019
WHERE EXISTS (
    SELECT 1 
    FROM select_top 
    WHERE select_top.category_id   = dbo.Nov_2019.category_id
      AND select_top.product_id    = dbo.Nov_2019.product_id
      AND select_top.category_code = dbo.Nov_2019.category_code
      AND select_top.brand         = dbo.Nov_2019.brand
)
