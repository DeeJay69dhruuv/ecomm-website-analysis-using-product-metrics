-- first the user conversion was calculated by the standard way, user_id purchased/ user_id viewed- this yielded a very high number
SELECT 
    (COUNT(DISTINCT CASE WHEN event_type = 'purchase' THEN user_id END)*100.0)/ 
    COUNT(DISTINCT CASE WHEN event_type = 'view' THEN user_id END) AS user_conversion_by_id
FROM dbo.Nov_2019;
/*then the user conversion was calculated by user_session- why this number dropped? 
a customer X viewing in the morning and then again in the evening generates 2 different sessions, 
suppose they purchase in the second session then this metric shows-
PEOPLE are comparing prices across platforms & returning later to buy- not INSTANT !!!
*/
SELECT 
    (COUNT(DISTINCT CASE WHEN event_type = 'purchase' THEN user_session END)*100.0)/ 
    COUNT(DISTINCT CASE WHEN event_type = 'view' THEN user_session END) AS user_conversion_by_session
FROM dbo.Nov_2019;

/* to calculate the ARPU using formula : total revenue / total number of users */
SELECT
    SUM(CASE WHEN event_type = 'purchase' THEN price ELSE 0 END) / COUNT(DISTINCT user_id) AS arpu
FROM dbo.Nov_2019;

/* average session duration - cumulative */
SELECT
    AVG(CAST(session_duration AS BIGINT)) AS average_session
FROM(
    SELECT
        user_session,
        DATEDIFF(second, MIN(event_time), MAX(event_time)) AS session_duration
    FROM dbo.Nov_2019
    GROUP BY user_session
    HAVING DATEDIFF(second, MIN(event_time), MAX(event_time)) > 0 
)t
