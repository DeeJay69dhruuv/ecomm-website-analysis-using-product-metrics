-- THE WORST category - shoes has less than 5% activation ratio, acquire is good but activation is very low in case of shoes
SELECT
    category_id,
    category_code,
    carts*100.0 / views AS drop_off_view_to_cart,
    purchases*100.0/ carts AS drop_off_cart_to_purchase,
    purchases*100.0/ views AS conversion_measure
FROM table_by_category
WHERE category_code LIKE '%shoe%';