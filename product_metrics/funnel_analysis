-- OVERALL funnel analysis of the entire 30 day dataset
WITH main_table AS(
    SELECT
        COUNT(DISTINCT CASE WHEN event_type = 'view' THEN user_id  END) AS view_event,
        COUNT(DISTINCT CASE WHEN event_type = 'cart' THEN user_id  END) AS cart_event,
        COUNT(DISTINCT CASE WHEN event_type = 'purchase' THEN user_id END) AS purchase_event
    FROM dbo.Nov_2019
) 
SELECT 
    cart_event*100.0 / view_event AS drop_off_view_to_cart,
    purchase_event*100.0/ cart_event AS drop_off_cart_to_purchase,
    purchase_event*100.0/ view_event AS conversion_measure
FROM main_table;


-- FUNNEL analysis by Category to pinpoint the worst and best category
WITH table_by_category AS (
    SELECT
        category_id,
        category_code,
        COUNT(DISTINCT CASE WHEN event_type = 'view' THEN user_id END) AS views,
        COUNT(DISTINCT CASE WHEN event_type = 'cart' THEN user_id END) AS carts,
        COUNT(DISTINCT CASE WHEN event_type = 'purchase' THEN user_id END) AS purchases
    FROM dbo.Nov_2019
    GROUP BY category_id, category_code
    HAVING COUNT(DISTINCT CASE WHEN event_type = 'cart' THEN user_id  END)  > 0 
    AND
    COUNT(DISTINCT CASE WHEN event_type = 'purchase' THEN user_id  END) > 0

)
